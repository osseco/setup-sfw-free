{
  "name": "setup-sfw-free",
  "version": "0.0.0",
  "private": true,
  "description": "GitHub Action that installs Socket Firewall Free (sfw), verified against pinned checksums",
  "homepage": "https://github.com/osseco/setup-sfw-free#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/osseco/setup-sfw-free.git"
  },
  "bugs": {
    "url": "https://github.com/osseco/setup-sfw-free/issues"
  },
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.18.0+sha512.9d7882d5dc82147ecfc4e062aa34834e0ad0296710a1837a1115ae012127d36b7109e321ac1598a1dd0a65597681b1e99917e12ed0d749eae91187943363beb3",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "format": "biome format --write",
    "format:check": "biome format",
    "lint": "biome lint",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage --test-coverage-include=src/** --test-coverage-lines=90 --test-coverage-branches=80"
  },
  "dependencies": {
    "@actions/cache": "6.3.0",
    "@actions/core": "3.0.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.7",
    "esbuild": "0.28.2"
  }
}
